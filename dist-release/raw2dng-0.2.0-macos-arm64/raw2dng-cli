#!/usr/bin/env bash
# Portable raw2dng — no Python. Expects ./dnglab beside this script.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
DNGLAB="${RAW2DNG_DNGLAB:-${DNGLAB:-$HERE/dnglab}}"

usage() {
  cat >&2 <<'USAGE'
Usage:
  raw2dng <input.RAW> [output.dng]
  raw2dng <input_dir> <output_dir>
  raw2dng a.RAW b.RAW <output_dir>
  raw2dng -r <input_dir> <output_dir>
  raw2dng -f ...                 # overwrite existing .dng
  raw2dng -V
  raw2dng -h
USAGE
}

if [[ $# -lt 1 ]]; then usage; exit 1; fi
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  -V|--version) echo "raw2dng 0.2.0 (portable)"; exit 0 ;;
esac

if [[ ! -e "$DNGLAB" ]]; then
  echo "dnglab not found next to raw2dng. Re-download the release package." >&2
  echo "Or set RAW2DNG_DNGLAB=/path/to/dnglab" >&2
  exit 2
fi
if [[ ! -x "$DNGLAB" ]]; then
  echo "dnglab is not executable: $DNGLAB" >&2
  exit 2
fi

force=0
recursive=0
args=()
for a in "$@"; do
  case "$a" in
    -f) force=1 ;;
    -r) recursive=1 ;;
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "raw2dng 0.2.0 (portable)"; exit 0 ;;
    --which-dnglab) echo "$DNGLAB"; exit 0 ;;
    -*) echo "unknown option: $a" >&2; usage; exit 1 ;;
    *) args+=("$a") ;;
  esac
done

if [[ ${#args[@]} -lt 1 ]]; then usage; exit 1; fi

run_one() {
  local inp="$1" out="$2"
  if [[ -e "$out" && "$force" -ne 1 ]]; then
    echo "건너뜀 (이미 있음, -f로 덮어쓰기): $out" >&2
    return 0
  fi
  if [[ ! -e "$inp" ]]; then
    echo "입력 경로가 없습니다: $inp" >&2
    return 1
  fi
  local cmd=("$DNGLAB" convert)
  [[ "$force" -eq 1 ]] && cmd+=(-f)
  cmd+=("$inp" "$out")
  echo "$(basename "$inp") → $out"
  "${cmd[@]}"
}

if [[ ${#args[@]} -eq 1 ]]; then
  inp="${args[0]}"
  if [[ -d "$inp" ]]; then
    echo "폴더 변환 시 출력 폴더 필요: raw2dng <in_dir> <out_dir>" >&2
    exit 1
  fi
  if [[ ! -e "$inp" ]]; then
    echo "입력 경로가 없습니다: $inp" >&2
    exit 1
  fi
  out="${inp%.*}.dng"
  run_one "$inp" "$out"
  exit $?
fi

out="${args[-1]}"
inputs=("${args[@]:0:${#args[@]}-1}")

# Single input file → custom .dng path (not a directory batch)
if [[ ${#inputs[@]} -eq 1 && -f "${inputs[0]}" && "${out##*.}" == "dng" ]]; then
  mkdir -p "$(dirname "$out")"
  run_one "${inputs[0]}" "$out"
  exit $?
fi

if [[ ${#inputs[@]} -eq 1 && -d "${inputs[0]}" ]]; then
  mkdir -p "$out"
  cmd=("$DNGLAB" convert)
  [[ "$force" -eq 1 ]] && cmd+=(-f)
  [[ "$recursive" -eq 1 ]] && cmd+=(-r)
  cmd+=("${inputs[0]}" "$out")
  exec "${cmd[@]}"
fi

# Multi-file → output directory
mkdir -p "$out"
rc=0
for inp in "${inputs[@]}"; do
  if [[ ! -e "$inp" ]]; then
    echo "입력 경로가 없습니다: $inp" >&2
    rc=1
    continue
  fi
  base="$(basename "$inp")"
  stem="${base%.*}"
  dest="$out/$stem.dng"
  if ! run_one "$inp" "$dest"; then rc=1; fi
done
exit "$rc"
